{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key_id",
    "manifest",
    "signature"
  ],
  "properties": {
    "key_id": {
      "type": "string"
    },
    "signature": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "correlation_id",
        "idempotency_id",
        "shop",
        "account",
        "integration",
        "actor",
        "session_generation",
        "authorization_revision",
        "policy_revision",
        "payload_digest",
        "journal_revision",
        "event_hash",
        "version",
        "issuer",
        "audience",
        "phase",
        "epoch",
        "sequence",
        "issued",
        "expires"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "idempotency_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "shop": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "account": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "integration": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "actor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "session_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authorization_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "journal_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "const": 1
        },
        "issuer": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "phase": {
          "const": "SEND_ADMISSION"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issued": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expires": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "description": "Offline fixture. Verify canonical bytes, pinned Ed25519 key/issuer/audience and bounded freshness in code."
}
