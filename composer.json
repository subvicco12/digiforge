{
  "name": "kinetiq-matrix-designs/digiforge",
  "description": "WordPress-native operations platform for the DigiCraftify ecosystem.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^4.0",
    "yoast/phpunit-polyfills": "^3.1"
  },
  "autoload-dev": {
    "psr-4": {
      "DigiForge\\Tests\\": "tests/unit/"
    }
  },
  "scripts": {
    "test": [
      "@test:legacy",
      "@test:unit",
      "@analyse",
      "@standards"
    ],
    "test:legacy": [
      "php tests/test-foundation.php",
      "php tests/test-product-factory.php",
      "php tests/test-digital-product-factory.php"
    ],
    "test:unit": "phpunit --configuration phpunit.xml.dist",
    "analyse": "phpstan analyse --configuration phpstan.neon.dist --no-progress",
    "standards": "phpcs --standard=phpcs.xml.dist",
    "test:wordpress": "phpunit --configuration phpunit.wordpress.xml.dist"
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  }
}
