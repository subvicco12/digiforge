{
  "name": "digiforge-custody-qualification",
  "main": "custody-bridge/entrypoint.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [{"type": "ESModule", "globs": ["custody-bridge/bridge.mjs", "custody-bridge/entrypoint.mjs", "protocol.mjs", "stage-a/egress.mjs"], "fallthrough": false}],
  "observability": {"enabled": false},
  "upload_source_maps": false,
  "keep_vars": false,
  "vars": {"DF_CUSTODY_MODE": "DISABLED", "DF_CUSTODY_SCOPE_JSON": ""},
  "durable_objects": {"bindings": [{"name": "DF_CUSTODY_STATE", "class_name": "CustodyFixtureState"}]},
  "migrations": [{"tag": "custody-fixture-v1", "new_sqlite_classes": ["CustodyFixtureState"]}]
}
