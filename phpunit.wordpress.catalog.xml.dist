<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/wordpress/bootstrap.php" colors="true" failOnWarning="true" failOnRisky="true">
    <php><env name="WP_ENVIRONMENT_TYPE" value="production" force="true"/></php>
    <testsuites>
        <testsuite name="DigiForge main-site catalog authorization">
            <file>tests/wordpress/PrintifyCatalogReadTest.php</file>
            <file>tests/wordpress/PrintifyCatalogIntegrationTest.php</file>
            <file>tests/wordpress/PrintifyCatalogScopedSmokeTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
