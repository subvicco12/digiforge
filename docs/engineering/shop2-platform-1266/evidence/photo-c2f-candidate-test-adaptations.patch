+<?php
+declare(strict_types=1);
+use DigiForge\Orders\PersonalizationCurrentness;
+require_once dirname(__DIR__,4).'/tests/wordpress/CustomerPhotoHeldIntegrationTest.php';
+/** Candidate-only availability/security assessment; does not alter accepted B handlers. */
+final class CustomerPhotoCandidateConsumerBoundaryTest extends CustomerPhotoHeldIntegrationTest {
+ public function testStableManagedCallerTransactionIsExplicitlyDeniedWithoutFinishingCallerFrame():void {
+  $f=$this->photo();$service=new PersonalizationCurrentness();self::assertNotWPError($service->forOrder($f['order']));global $wpdb;$marker='digiforge_candidate_stable_pending_'.wp_generate_uuid4();self::assertNotFalse($wpdb->query('START TRANSACTION'));self::assertSame(1,$wpdb->insert($wpdb->comments,['comment_content'=>$marker,'comment_agent'=>'pending']));try{$result=$service->forOrder($f['order']);self::assertWPError($result);self::assertSame('photo_current_read_caller_transaction',$result->get_error_code());self::assertFalse($result->get_error_data()['external_execution_authorized']);self::assertSame('1',(string)$wpdb->get_var('SELECT @@session.in_transaction'));self::assertSame('pending',$wpdb->get_var($wpdb->prepare('SELECT comment_agent FROM '.$wpdb->comments.' WHERE comment_content=%s',$marker)));}finally{$wpdb->query('ROLLBACK');$after=$wpdb->get_var($wpdb->prepare('SELECT comment_agent FROM '.$wpdb->comments.' WHERE comment_content=%s',$marker));$wpdb->delete($wpdb->comments,['comment_content'=>$marker]);self::assertNull($after);}self::assertNotWPError($service->forOrder($f['order']));
+ }
+}
