    "request_id_and_challenge": "base64url encoding of32 independently random bytes; persist one-use consumption",
    "timestamps": "integer UTC seconds; issued_at<=now<expires_at; lifetime<=300",
    "revisions_and_generations": "integers1..9007199254740991; monotonic; overflow denies",
    "product_versions": "integers0..9007199254740991, authoritative current/expected semantics required",
    "method": "exact enum from methods; mandatory in signed bytes",
    "provider": "printify only",
    "environment": "explicit production or test; no inferred default",
    "shop_id": "2 for initial qualification; Shop3 deferred",
    "shop_key": "personalized_pod",
    "method_body": "exact required typed fields for selected method; unknown fields denied"
